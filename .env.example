# Copy to .env (ignored by Git) and adjust for your machine:
#   cp .env.example .env
# The values below match compose.yaml's local-only development credentials.
# Never commit real credentials; .env stays local.

# Backend runtime database (the `db` Compose service).
DATABASE_URL=postgresql+psycopg://valscores:valscores@localhost:5432/valscores

# Disposable database for the backend regression suite (the `test-db` Compose
# service, started with `docker compose --profile test up -d --wait test-db`).
# Leave commented out to run tests against isolated SQLite databases; uncomment
# only while test-db is running. Tests refuse any database whose name does not
# contain "test".
# TEST_DATABASE_URL=postgresql+psycopg://valscores:valscores@localhost:5433/valscores_test

# Host ports Compose publishes. Change them if 5432/5433 are already taken,
# and update the URLs above to match.
VALSCORES_DB_PORT=5432
VALSCORES_TEST_DB_PORT=5433

# Backend URL the iOS app calls. The app does not read this file; it is listed
# here for reference. Set it as an Xcode launch argument instead, e.g.
#   -VALSCORES_API_BASE_URL http://192.168.1.20:8000
# The Simulator default (http://127.0.0.1:8000) needs no configuration.
VALSCORES_API_BASE_URL=http://127.0.0.1:8000
